{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cook",
  "main": "src/worker.ts",
  "route": "cook.chalmrah.co.uk/*",
  "account_id": "b94aad8e28dc212844025be36a152fe3",
  "compatibility_date": "2025-04-10",

  "build": {
    // Regenerate recipes.json and build-info.json before Wrangler bundles the worker
    "command": "npm run build:recipes && npm run build:info"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },


  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "kv_namespaces": [
  ],
  "vars": {

  }
}